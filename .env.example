# Copy to .env.local (development) or set in your host's dashboard (production).

# ── Sign-in ────────────────────────────────────────────────────────────────────
# Signs doctor session cookies. 32+ random characters. Required in production.
#   node -p "require('crypto').randomBytes(32).toString('base64url')"
AUTH_SECRET=

# Password for the demo doctor (meera.shah@doctorflow.test). Applied on start-up
# only while that doctor has no password yet.
DOCTORFLOW_DEMO_PASSWORD=

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite file. Defaults to ./data/doctorflow.sqlite. On a host, point this at a
# persistent volume, e.g. /data/doctorflow.sqlite
# DATABASE_PATH=

# ── Clinic ─────────────────────────────────────────────────────────────────────
# Time zone used for "today", past slots and reminders.
NEXT_PUBLIC_CLINIC_TIME_ZONE=Asia/Kolkata
# Country code added to 10-digit numbers typed without one.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91

# ── WhatsApp ───────────────────────────────────────────────────────────────────
# "simulated" (default): nothing is sent; play patients from /whatsapp.
# "meta": real messages through the WhatsApp Cloud API. See docs/WhatsApp_Setup_Guide.md
WHATSAPP_PROVIDER=simulated
# Doctor that WhatsApp patients book with.
WHATSAPP_DOCTOR_ID=doctor-meera-shah
# The clinic's WhatsApp number as patients see it.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# From Meta (needed when WHATSAPP_PROVIDER=meta):
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any string you choose; type the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v23.0

# Optional approved template for reminders sent more than 24 h after the
# patient's last message. Body example: "Update from your clinic: {{1}}"
# WHATSAPP_REMINDER_TEMPLATE=
# WHATSAPP_TEMPLATE_LANGUAGE=en

# ── Scheduled reminders ────────────────────────────────────────────────────────
# A scheduler calls GET /api/cron/reminders with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
